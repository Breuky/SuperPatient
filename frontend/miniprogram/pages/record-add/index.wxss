/* pages/record-add/index.wxss */

.page-container {
  padding-bottom: 120rpx;
}

/* Section */
.section {
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  padding: 20rpx 24rpx 12rpx;
}

.section-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-hint);
  margin-left: 12rpx;
}

/* 分类 Tab */
.category-tabs {
  white-space: nowrap;
  padding: 0 24rpx 8rpx;
}

.cat-tab {
  display: inline-block;
  padding: 14rpx 32rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  background: #fff;
  margin-right: 16rpx;
  border: 2rpx solid transparent;
}

.cat-tab.active {
  background: #F0FFF4;
  color: var(--primary);
  border-color: var(--primary);
  font-weight: 600;
}

/* 表单行 */
.form-group {
  margin: 0 24rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.form-row:last-child {
  border-bottom: none;
}

.row-label {
  width: 140rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.row-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.row-input {
  flex: 1;
  font-size: 28rpx;
  height: 48rpx;
  line-height: 48rpx;
}

/* 指标卡片 */
.indicators-list {
  padding: 0 24rpx;
}

.indicator-card {
  margin: 0 0 12rpx;
  padding: 20rpx 24rpx;
}

.indicator-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.indicator-name {
  font-size: 28rpx;
  font-weight: 600;
}

.indicator-range {
  font-size: 22rpx;
  color: var(--text-hint);
  background: #F5F5F5;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

.indicator-input-row {
  display: flex;
  align-items: center;
}

.indicator-input {
  flex: 1;
  height: 72rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 0 20rpx;
  font-size: 30rpx;
}

.indicator-unit {
  width: 100rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-hint);
  flex-shrink: 0;
}

.indicator-textarea {
  width: 100%;
  min-height: 100rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 14rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 上传 */
.upload-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 160rpx;
  border: 2rpx dashed #ddd;
  border-radius: var(--radius-sm);
}

.upload-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 24rpx;
  color: var(--text-hint);
}

.image-preview {
  position: relative;
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 300rpx;
}

.image-remove {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.5);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

/* 提交 */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--border-color);
  z-index: 100;
}

.submit-bar .btn-primary {
  border-radius: var(--radius-md);
}
