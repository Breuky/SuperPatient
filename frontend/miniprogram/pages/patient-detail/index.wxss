/* pages/patient-detail/index.wxss */

.page-container {
  padding-bottom: 40rpx;
  min-height: 100vh;
}

/* 患者信息卡 */
.info-card {
  background: linear-gradient(135deg, #07C160, #06AD56);
  margin: 20rpx 24rpx;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  color: #fff;
}

.info-header {
  display: flex;
  align-items: flex-start;
}

.info-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  border: 3rpx solid rgba(255,255,255,0.4);
  flex-shrink: 0;
  margin-right: 20rpx;
}

.avatar-male { background: rgba(255,255,255,0.2); }
.avatar-female { background: rgba(255,255,255,0.25); }

.info-main {
  flex: 1;
  min-width: 0;
}

.info-name {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.info-gender {
  font-size: 24rpx;
  font-weight: 400;
  opacity: 0.8;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 20rpx;
}

.info-age {
  font-size: 24rpx;
  font-weight: 400;
  opacity: 0.8;
  margin-left: 8rpx;
}

.info-meta {
  font-size: 22rpx;
  opacity: 0.75;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-actions {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}

.action-btn {
  font-size: 32rpx;
  padding: 8rpx;
}

/* 统计 */
.stats-row {
  display: flex;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255,255,255,0.2);
}

.stat-block {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.stat-label {
  display: block;
  font-size: 20rpx;
  opacity: 0.7;
  margin-top: 4rpx;
}

.category-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.cat-stat-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 20rpx;
}

/* 操作栏 */
.action-bar {
  display: flex;
  gap: 12rpx;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}

.action-bar .btn-primary {
  flex: 2;
  height: 72rpx;
  font-size: 26rpx;
  border-radius: var(--radius-md);
}

.action-bar .btn-outline {
  flex: 1;
  height: 72rpx;
  font-size: 24rpx;
  border-radius: var(--radius-md);
  background: #fff;
  color: var(--primary);
  border: 2rpx solid var(--primary);
}

/* 分类筛选 */
.category-filter {
  white-space: nowrap;
  padding: 12rpx 24rpx 16rpx;
}

.filter-item {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: #fff;
  margin-right: 12rpx;
  border: 2rpx solid transparent;
}

.filter-item.active {
  background: #F0FFF4;
  color: var(--primary);
  border-color: var(--primary);
  font-weight: 600;
}

/* 日期筛选 */
.date-filter {
  display: flex;
  align-items: center;
  padding: 0 24rpx 16rpx;
  gap: 12rpx;
}

.date-picker {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  background: #fff;
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  color: var(--text-primary);
}

.date-picker.placeholder {
  color: var(--text-hint);
}

.date-sep {
  font-size: 24rpx;
  color: var(--text-hint);
}

/* 检查记录 */
.record-list {
  padding: 0 24rpx;
}

.record-card {
  position: relative;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--shadow-sm);
}

.record-card:active {
  transform: scale(0.98);
}

.record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.record-category {
  font-size: 28rpx;
  font-weight: 600;
}

.record-body {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 6rpx;
}

.record-footer {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--text-hint);
}

.arrow-right {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: #ccc;
}

/* 与 index 页共享的弹窗样式 */
.gender-switch {
  display: flex;
  gap: 16rpx;
}

.gender-option {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--border-color);
  font-size: 28rpx;
  color: var(--text-secondary);
}

.gender-option.active {
  border-color: var(--primary);
  background: #F0FFF4;
  color: var(--primary);
  font-weight: 600;
}
