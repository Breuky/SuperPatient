<!-- pages/index/index.wxml - 患者列表页 -->
<view class="page-container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索患者姓名..."
        value="{{keyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
        confirm-type="search"
      />
    </view>
    <view class="add-btn" bindtap="openAddModal">+ 新增</view>
  </view>

  <!-- 患者列表 -->
  <view wx:if="{{patients.length > 0}}" class="patient-list">
    <view
      wx:for="{{patients}}"
      wx:key="id"
      class="patient-card"
      data-id="{{item.id}}"
      bindtap="onPatientTap"
    >
      <view class="card-left">
        <view class="avatar {{item.gender === 1 ? 'avatar-male' : 'avatar-female'}}">
          {{item.name[0]}}
        </view>
      </view>
      <view class="card-center">
        <view class="patient-name">{{item.name}}</view>
        <view class="patient-meta">
          <text>{{item.genderText}}</text>
          <text wx:if="{{item.age}}"> · {{item.age}}岁</text>
          <text wx:if="{{item.diagnosisDate}}"> · {{item.diagnosisDate}}确诊</text>
        </view>
        <view class="patient-stats">
          <text class="stat-item">检查 {{item.totalExams}} 次</text>
          <text class="stat-divider">|</text>
          <text class="stat-item">最近 {{item.lastExamDate || '暂无'}}</text>
        </view>
      </view>
      <view class="card-right">
        <view wx:if="{{item.abnormalCount > 0}}" class="abnormal-badge">
          {{item.abnormalCount}}
        </view>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{!loading}}" class="empty-state">
    <text class="empty-icon">📋</text>
    <text class="empty-text">{{keyword ? '未找到匹配的患者' : '暂无患者，点击右上角新增'}}</text>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="load-more">加载中...</view>
  <view wx:elif="{{noMore && patients.length > 0}}" class="load-more">— 没有更多了 —</view>
</view>

<!-- 新增患者弹窗 -->
<view wx:if="{{showAddModal}}" class="modal-mask" bindtap="closeAddModal">
  <view class="modal-content" catchtap="">
    <view class="modal-header">
      <text class="modal-title">新增患者</text>
      <text class="modal-close" bindtap="closeAddModal">✕</text>
    </view>

    <view class="modal-body">
      <!-- 姓名 -->
      <view class="form-item">
        <text class="form-label">姓名 <text class="required">*</text></text>
        <input class="form-input" placeholder="请输入患者姓名" value="{{formData.name}}" data-field="name" bindinput="onFieldChange"/>
      </view>

      <!-- 性别 -->
      <view class="form-item">
        <text class="form-label">性别</text>
        <view class="gender-switch">
          <view class="gender-option {{formData.gender === 1 ? 'active' : ''}}" data-gender="1" bindtap="onGenderChange">男</view>
          <view class="gender-option {{formData.gender === 0 ? 'active' : ''}}" data-gender="0" bindtap="onGenderChange">女</view>
        </view>
      </view>

      <!-- 出生日期 -->
      <view class="form-item">
        <text class="form-label">出生日期</text>
        <picker mode="date" value="{{formData.birthDate}}" data-field="birthDate" bindchange="onDateChange">
          <view class="form-picker {{formData.birthDate ? '' : 'placeholder'}}">
            {{formData.birthDate || '请选择'}}
          </view>
        </picker>
      </view>

      <!-- 确诊日期 -->
      <view class="form-item">
        <text class="form-label">确诊日期</text>
        <picker mode="date" value="{{formData.diagnosisDate}}" data-field="diagnosisDate" bindchange="onDateChange">
          <view class="form-picker {{formData.diagnosisDate ? '' : 'placeholder'}}">
            {{formData.diagnosisDate || '请选择'}}
          </view>
        </picker>
      </view>

      <!-- 联系电话 -->
      <view class="form-item">
        <text class="form-label">联系电话</text>
        <input class="form-input" type="number" placeholder="选填" value="{{formData.phone}}" data-field="phone" bindinput="onFieldChange"/>
      </view>

      <!-- 备注 -->
      <view class="form-item">
        <text class="form-label">备注</text>
        <textarea class="form-textarea" placeholder="常规分型、分期等（选填）" value="{{formData.notes}}" data-field="notes" bindinput="onFieldChange" maxlength="500"/>
      </view>
    </view>

    <view class="modal-footer">
      <button class="btn-primary" bindtap="submitAddPatient" loading="{{submitting}}" disabled="{{submitting}}">
        确认添加
      </button>
    </view>
  </view>
</view>
