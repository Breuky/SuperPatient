/* pages/index/index.wxss */

.page-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  gap: 16rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 12rpx 20rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 40rpx;
  line-height: 40rpx;
}

.add-btn {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  white-space: nowrap;
}

/* 患者卡片 */
.patient-list {
  padding-top: 12rpx;
}

.patient-card {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 0 24rpx 12rpx;
  border-radius: var(--radius-md);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s;
}

.patient-card:active {
  transform: scale(0.98);
}

.card-left {
  margin-right: 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.avatar-male {
  background: linear-gradient(135deg, #4A90D9, #357ABD);
}

.avatar-female {
  background: linear-gradient(135deg, #E88BA7, #D4687C);
}

.card-center {
  flex: 1;
  min-width: 0;
}

.patient-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.patient-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 6rpx;
}

.patient-stats {
  font-size: 22rpx;
  color: var(--text-hint);
}

.stat-divider {
  margin: 0 8rpx;
  color: #ddd;
}

.card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.abnormal-badge {
  background: var(--danger);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.arrow {
  font-size: 36rpx;
  color: #ccc;
  line-height: 1;
}

/* 弹窗 */
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
}

.modal-close {
  font-size: 36rpx;
  color: var(--text-hint);
  padding: 8rpx;
}

.modal-body {
  max-height: 60vh;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  display: block;
}

.required {
  color: var(--danger);
}

.form-input {
  width: 100%;
  height: 76rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  height: 76rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 0 20rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.form-picker.placeholder {
  color: var(--text-hint);
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.gender-switch {
  display: flex;
  gap: 16rpx;
}

.gender-option {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--border-color);
  font-size: 28rpx;
  color: var(--text-secondary);
}

.gender-option.active {
  border-color: var(--primary);
  background: #F0FFF4;
  color: var(--primary);
  font-weight: 600;
}

.modal-footer {
  margin-top: 30rpx;
}

.modal-footer .btn-primary {
  width: 100%;
}
