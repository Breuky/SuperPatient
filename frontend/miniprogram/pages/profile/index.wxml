<!-- pages/profile/index.wxml - 个人中心 -->
<view class="page-container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-avatar-wrap" bindtap="onChooseAvatar">
      <image wx:if="{{userInfo && userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" class="user-avatar" mode="aspectFill"/>
      <view wx:else class="user-avatar-placeholder">
        <text class="avatar-text">{{userInfo && userInfo.nickname ? userInfo.nickname[0] : '👤'}}</text>
      </view>
      <view class="avatar-badge">📷</view>
    </view>
    <text class="user-name" bindtap="openEditModal">
      {{userInfo ? userInfo.nickname || '未设置昵称' : '加载中...'}}
    </text>
    <text class="user-phone" wx:if="{{userInfo && userInfo.phone}}">{{userInfo.phone}}</text>
    <view class="user-actions">
      <text class="user-action-btn" bindtap="openEditModal">✏️ 编辑</text>
    </view>
  </view>

  <!-- 统计 -->
  <view class="stats-card card" wx:if="{{statistics}}">
    <view class="stat-item">
      <text class="stat-num">{{statistics.patientCount}}</text>
      <text class="stat-label">患者数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{statistics.recordCount}}</text>
      <text class="stat-label">检查记录</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{statistics.indicatorCount}}</text>
      <text class="stat-label">覆盖指标</text>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-section">
    <view class="menu-group">
      <view class="menu-item" bindtap="openEditModal">
        <text class="menu-icon">👤</text>
        <text class="menu-text">编辑个人资料</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-item">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-text">关于 SuperPatient</text>
        <text class="menu-desc">v1.0.0</text>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-item" bindtap="onLogout">
        <text class="menu-icon" style="color:#FA5151;">🚪</text>
        <text class="menu-text" style="color:#FA5151;">退出登录</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>
</view>

<!-- 编辑资料弹窗 -->
<view wx:if="{{showEditModal}}" class="modal-mask" bindtap="closeEditModal">
  <view class="modal-content" catchtap="">
    <view class="modal-header">
      <text class="modal-title">编辑资料</text>
      <text class="modal-close" bindtap="closeEditModal">✕</text>
    </view>
    <view class="modal-body">
      <view class="form-item">
        <text class="form-label">昵称</text>
        <input class="form-input" placeholder="请输入昵称" value="{{editForm.nickname}}" data-field="nickname" bindinput="onEditFieldChange"/>
      </view>
      <view class="form-item">
        <text class="form-label">手机号</text>
        <input class="form-input" type="number" placeholder="选填" value="{{editForm.phone}}" data-field="phone" bindinput="onEditFieldChange"/>
      </view>
      <view class="form-tip">点击上方头像可拍照更换</view>
    </view>
    <view class="modal-footer">
      <button class="btn-primary" bindtap="submitEdit" loading="{{submitting}}" disabled="{{submitting}}">保存</button>
    </view>
  </view>
</view>
