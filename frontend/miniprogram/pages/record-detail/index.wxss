/* pages/record-detail/index.wxss */

.page-container {
  padding-bottom: 40rpx;
  min-height: 100vh;
}

/* 报告照片 */
.image-section {
  margin: 0 24rpx 16rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  position: relative;
}

.report-image {
  width: 100%;
}

.image-tip {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  text-align: center;
  padding: 12rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.5));
  color: #fff;
  font-size: 22rpx;
}

/* 信息区域 */
.info-section {
  margin: 0 24rpx 16rpx;
}

.info-row {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 140rpx;
  color: var(--text-hint);
  font-size: 26rpx;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.note-text {
  line-height: 1.6;
  color: var(--text-secondary);
}

/* 指标值 */
.section {
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  padding: 20rpx 24rpx 12rpx;
}

.values-list {
  padding: 0 24rpx;
}

.value-card {
  margin: 0 0 12rpx;
  padding: 20rpx 24rpx;
}

.value-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.value-name {
  font-size: 28rpx;
  font-weight: 600;
}

.value-body {
  position: relative;
}

.value-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.value-num.value-abnormal {
  color: var(--danger);
}

.value-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-hint);
  margin-left: 8rpx;
}

.value-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

.value-range {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
}

/* 操作按钮 */
.action-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
}

.action-footer .btn-outline,
.action-footer .btn-danger {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  border-radius: var(--radius-md);
}

.action-footer .btn-outline {
  background: #fff;
  border: 2rpx solid var(--primary);
  color: var(--primary);
}

/* 编辑模式 */
.edit-header {
  padding-top: 10rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.form-row:last-child {
  border-bottom: none;
}

.row-label {
  width: 140rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.row-input {
  flex: 1;
  font-size: 28rpx;
  height: 48rpx;
}

.edit-value-card {
  margin: 0 24rpx 12rpx;
}

.edit-value-name {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}

.edit-value-input {
  height: 72rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 0 20rpx;
  font-size: 30rpx;
}

.edit-value-textarea {
  width: 100%;
  min-height: 100rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 14rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.double-btn {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
}

.double-btn .btn-outline,
.double-btn .btn-primary {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  border-radius: var(--radius-md);
}

.double-btn .btn-outline {
  background: #fff;
  border: 2rpx solid var(--border-color);
  color: var(--text-secondary);
}
