<!-- pages/trend/index.wxml - 趋势图表页 -->
<view class="page-container">
  <!-- 患者选择 -->
  <view class="section">
    <view class="section-title">选择患者</view>
    <picker mode="selector" range="{{patients}}" range-key="name" value="{{patientIndex}}" bindchange="onPatientChange">
      <view class="picker-card card">
        <text wx:if="{{patients.length > 0}}">{{patients[patientIndex].name}}</text>
        <text wx:else>暂无患者</text>
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- 指标选择 -->
  <view class="section">
    <view class="section-title">选择指标（仅显示已录入数值型指标的）</view>
    <view wx:if="{{trendableIndicators.length > 0}}" class="indicator-grid">
      <view
        wx:for="{{trendableIndicators}}"
        wx:key="indicatorId"
        class="indicator-item {{selectedIndicatorId === item.indicatorId ? 'active' : ''}}"
        data-id="{{item.indicatorId}}"
        bindtap="onIndicatorTap"
      >
        <text class="ind-item-name">{{item.indicatorName}}</text>
        <text class="ind-item-meta">{{item.categoryName}} · {{item.recordCount}}次</text>
      </view>
    </view>
    <view wx:else class="empty-state">
      <text class="empty-icon">📊</text>
      <text class="empty-text">该患者暂无趋势数据</text>
    </view>
  </view>

  <!-- 趋势图 -->
  <view wx:if="{{points.length > 0 && selectedIndicator}}" class="chart-section">
    <view class="chart-header">
      <text class="chart-title">{{selectedIndicator.name}} 趋势</text>
      <text class="chart-unit" wx:if="{{selectedIndicator.unit}}">单位: {{selectedIndicator.unit}}</text>
    </view>

    <!-- Canvas 折线图 -->
    <view class="chart-canvas-wrap card">
      <canvas
        type="2d"
        id="trendCanvas"
        class="trend-canvas"
        style="width: 100%; height: 400rpx;"
      ></canvas>
    </view>

    <!-- 图例 -->
    <view class="chart-legend">
      <view class="legend-item">
        <view class="legend-dot normal"></view>
        <text>正常</text>
      </view>
      <view class="legend-item">
        <view class="legend-dot abnormal"></view>
        <text>异常</text>
      </view>
      <view class="legend-item">
        <view class="legend-zone"></view>
        <text>正常范围</text>
      </view>
    </view>

    <!-- 数据列表 -->
    <view class="points-list">
      <view wx:for="{{points}}" wx:key="recordId" class="point-item card">
        <text class="point-date">{{item.examDate}}</text>
        <text class="point-value {{item.isAbnormal ? 'abnormal' : ''}}">{{item.value}}</text>
        <view class="{{item.isAbnormal === 1 ? 'tag-abnormal-high' : item.isAbnormal === 2 ? 'tag-abnormal-low' : 'tag-normal'}}">
          {{item.isAbnormal === 1 ? '偏高' : item.isAbnormal === 2 ? '偏低' : '正常'}}
        </view>
      </view>
    </view>
  </view>

  <!-- 未选择 -->
  <view wx:elif="{{!selectedIndicatorId}}" class="empty-state">
    <text class="empty-icon">📈</text>
    <text class="empty-text">请选择上方指标查看趋势</text>
  </view>

  <!-- 无数据 -->
  <view wx:elif="{{points.length === 0}}" class="empty-state">
    <text class="empty-icon">📋</text>
    <text class="empty-text">该指标暂无数据</text>
  </view>
</view>
