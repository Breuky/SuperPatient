<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.superpatient.mapper.CategoryMapper">

    <resultMap id="baseMap" type="com.superpatient.entity.ExamCategory">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="icon" property="icon"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="findAll" resultMap="baseMap">
        SELECT * FROM exam_category ORDER BY sort_order ASC
    </select>

    <select id="findById" resultMap="baseMap">
        SELECT * FROM exam_category WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO exam_category (name, icon, sort_order)
        VALUES (#{name}, #{icon}, #{sortOrder})
    </insert>

    <update id="update">
        UPDATE exam_category
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM exam_category WHERE id = #{id}
    </delete>

</mapper>
